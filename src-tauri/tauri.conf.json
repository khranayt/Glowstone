{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glowstone",
  "version": "0.1.0",
  "identifier": "app.glowstone.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Glowstone",
        "width": 1360,
        "height": 860,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A local-first Markdown knowledge base",
    "longDescription": "Glowstone is an open-source, local-first Markdown knowledge base with tabs, live preview, backlinks and a force-directed graph view."
  }
}
